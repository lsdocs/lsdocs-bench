# Dev tasks for lsdocs-bench (run with `nur`; `nur --list` shows them).

use scripts/org.nu

# The `lsdocs` binary to time: LSDOCS_BIN if set, else lsdocs (release,
# default features) installed from git into target/lsdocs-bin. With
# LSDOCS_ORG_DIR set, from the local clones there.
def lsdocs-bin []: nothing -> string {
    let given = $env | get -o LSDOCS_BIN
    if $given != null and $given != "" { return $given }
    let root = $env.PWD | path join target lsdocs-bin
    with-env (org org-env) {
        cargo install --quiet --git $"($org.ORG_URL)/lsdocs" --root $root lsdocs
    }
    $root | path join bin (if $nu.os-info.name == "windows" { "lsdocs.exe" } else { "lsdocs" })
}

# Time release builds of a generated site: in-process, over stdio and over
# a pipe, cached and not, and with big pages.
def "nur bench" [--pages: int = 200, --runs: int = 3] {
    use scripts/bench.nu
    bench cases (lsdocs-bin) --pages $pages --runs $runs
}

# The tests of the nu scripts.
def "nur test scripts" [] {
    use scripts/tests/bench.nu
    bench
}

# What CI runs.
def "nur ci" [] {
    nur test scripts
}
